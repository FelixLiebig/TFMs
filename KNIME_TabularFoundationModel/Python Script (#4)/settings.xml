        <entry key="script" type="xstring" value="import knime.scripting.io as knio%%00010import pandas as pd%%00010%%00010from sklearn.model_selection import train_test_split%%00010from sklearn.metrics import accuracy_score%%00010from sklearn.ensemble import RandomForestClassifier%%00010%%00010# 1. Daten aus KNIME laden%%00010database = knio.input_tables[0].to_pandas()%%00010target_col = &quot;Churn&quot; %%00010%%00010if target_col not in database.columns:%%00010    raise ValueError(f&quot;Zielspalte '{target_col}' wurde nicht gefunden.&quot;)%%00010%%00010# Features und Zielvariable trennen (IDs herauswerfen)%%00010X = database.drop(columns=[target_col, &quot;customerID&quot;], errors=&quot;ignore&quot;)%%00010y = database[target_col]%%00010%%00010# 2. SICHERE DATENVORBEREITUNG: Textspalten in Dummies umwandeln (fängt 'Male', 'Female' etc. sauber ab!)%%00010X_processed = pd.get_dummies(X, drop_first=True)%%00010X_processed = X_processed.fillna(0)%%00010%%00010# 3. Train-Test-Split für den ehrlichen &quot;TÜV&quot;%%00010X_train, X_test, y_train, y_test = train_test_split(%%00010    X_processed, y, test_size=0.2, random_state=42, stratify=y%%00010)%%00010%%00010# 4. Random Forest initialisieren und trainieren%%00010print(&quot;Random Forest wird trainiert...&quot;)%%00010rf_model = RandomForestClassifier(random_state=42, n_estimators=100)%%00010rf_model.fit(X_train, y_train)%%00010%%00010# 5. Test-Vorhersage &amp; Genauigkeit prüfen%%00010y_pred_rf = rf_model.predict(X_test)%%00010acc_rf = accuracy_score(y_test, y_pred_rf)%%00010print(f&quot;--- Echte Test-Genauigkeit von Random Forest: {acc_rf * 100:.2f}% ---&quot;)%%00010%%00010# 6. Für die KNIME-Tabelle: Einmal auf dem Gesamtdatensatz fitten und vorhersagen%%00010rf_model.fit(X_processed, y)%%00010full_predictions = rf_model.predict(X_processed)%%00010%%00010output = database.copy()%%00010output['prediction'] = full_predictions%%00010%%00010# 7. Zurück an KNIME übergeben%%00010knio.output_tables[0] = knio.Table.from_pandas(output)%%00010print(&quot;Random Forest Skript erfolgreich in KNIME beendet!&quot;)"/>
